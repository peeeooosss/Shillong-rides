# Copy to .env for local dev. NEVER commit .env. NEVER expose these to the frontend.
# Production values live in Vercel -> Project -> Settings -> Environment Variables.

# Neon Postgres (pooled connection string). Server-side only.
DATABASE_URL=

# Secret for signing session JWTs. Generate: openssl rand -base64 32
SESSION_SECRET=

# Admin WhatsApp in international format WITHOUT "+" (used for wa.me redirect).
ADMIN_WHATSAPP=919864854481

# Rental terms version accepted by customers at booking time.
TERMS_VERSION=v1
